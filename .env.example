# Local Docker Compose defaults. Copy to .env and change secrets before shared use.
POSTGRES_DB=aidlink
POSTGRES_USER=aidlink
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_HOST_PORT=5433

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-local-password
GRAFANA_HOST_PORT=3002
PROMETHEUS_HOST_PORT=9091
LOKI_HOST_PORT=3101

# Optional host-only port used by docker-compose.share.yml.
SHARE_PROXY_HOST_PORT=8088

NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
AIDLINK_ENVIRONMENT=local-compose
AIDLINK_TRACE_SAMPLE_RATE=0.1
AIDLINK_SECURE_COOKIE=false
AIDLINK_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Admin creation is opt-in. Use at least 12 characters when enabled.
AIDLINK_BOOTSTRAP_ADMIN_ENABLED=false
AIDLINK_BOOTSTRAP_ADMIN_EMAIL=
AIDLINK_BOOTSTRAP_ADMIN_PASSWORD=

# External integrations remain disabled until official credentials are supplied.
AIDLINK_GOV24_SERVICE_KEY=
AIDLINK_GOV24_SCHEDULING_ENABLED=false
AIDLINK_GOV24_CRON=0 0 3 * * *
AIDLINK_GOV24_SOURCE_REMOVED_THRESHOLD=3
# Start after a manual source-link check. Each run checks at most 20 due policies.
AIDLINK_LINK_CHECK_SCHEDULING_ENABLED=false
AIDLINK_LINK_CHECK_CRON=0 */30 * * * *
AIDLINK_LINK_CHECK_BATCH_SIZE=20
AIDLINK_OPENAI_ENABLED=false
AIDLINK_OPENAI_API_KEY=
AIDLINK_OPENAI_MODEL=gpt-5.6-terra
AIDLINK_AI_INPUT_USD_PER_MILLION=0
AIDLINK_AI_OUTPUT_USD_PER_MILLION=0
AIDLINK_AI_PIPELINE_SCHEDULING_ENABLED=false
