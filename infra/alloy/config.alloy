discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "aidlink" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/aidlink-.+"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(aidlink-.+)"
    target_label  = "container"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/aidlink-(.+)"
    target_label  = "service"
  }
}

loki.source.docker "aidlink" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.aidlink.output
  forward_to = [loki.process.aidlink.receiver]
}

loki.process "aidlink" {
  stage.json {
    expressions = {
      level   = "log.level",
      traceId = "trace.id",
      spanId  = "span.id",
    }
  }

  stage.labels {
    values = {
      level = "",
    }
  }

  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
