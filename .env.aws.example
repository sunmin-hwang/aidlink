# AWS single-host deployment. Copy to .env.aws on the EC2 host and replace secrets.
AIDLINK_DOMAIN=aidlink.example.com

# Use the private RDS endpoint emitted by Terraform.
AIDLINK_DB_URL=jdbc:postgresql://aidlink.example.ap-northeast-2.rds.amazonaws.com:5432/aidlink?sslmode=require
AIDLINK_DB_USERNAME=aidlink_admin
AIDLINK_DB_PASSWORD=replace-with-the-rds-password

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-grafana-password

# Admin creation is opt-in. Disable it and remove the password after first startup.
AIDLINK_BOOTSTRAP_ADMIN_ENABLED=false
AIDLINK_BOOTSTRAP_ADMIN_EMAIL=
AIDLINK_BOOTSTRAP_ADMIN_PASSWORD=

# Keep paid/external integrations disabled until credentials and budgets are ready.
AIDLINK_GOV24_SERVICE_KEY=
AIDLINK_GOV24_SCHEDULING_ENABLED=false
AIDLINK_GOV24_DAILY_TIME=03:00
AIDLINK_OPENAI_ENABLED=false
AIDLINK_OPENAI_API_KEY=
AIDLINK_OPENAI_MODEL=gpt-5.6-terra
AIDLINK_AI_INPUT_USD_PER_MILLION=0
AIDLINK_AI_OUTPUT_USD_PER_MILLION=0
AIDLINK_AI_PIPELINE_SCHEDULING_ENABLED=false

# Enable briefing email only after testing, recipient confirmation and send approval.
AIDLINK_BRIEFING_MAIL_ENABLED=false
AIDLINK_BRIEFING_MAIL_SCHEDULING_ENABLED=false
AIDLINK_BRIEFING_MAIL_FROM=
AIDLINK_BRIEFING_MAIL_ALLOWED_RECIPIENTS=
AIDLINK_BRIEFING_MAIL_POLL_MS=10000
AIDLINK_SMTP_HOST=localhost
AIDLINK_SMTP_PORT=587
AIDLINK_SMTP_USERNAME=
AIDLINK_SMTP_PASSWORD=
AIDLINK_SMTP_AUTH=true
AIDLINK_SMTP_STARTTLS=true

# A low sampling rate keeps the 2 GiB host's Tempo footprint predictable.
AIDLINK_TRACE_SAMPLE_RATE=0.05
